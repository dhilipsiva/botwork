# Comparisons preserve integer precision; arithmetic still returns f32 when mixed.
Log |16777217 == 16777216.0|
Log |16777217 > 16777216.0|
Log |2147483647 < 2147483648.0|
Log |16777217 + 0.0 == 16777216.0|
Log |0.0 == -0.0|

# Arrays are ordered; map equality ignores entry order and compares nested values.
Log |[1, 2] == [1.0, 2.0]|
Log |[1, 2] == [2, 1]|
Log |{a: 1, b: [2, 3]} == {b: [2.0, 3.0], a: 1.0}|
Log |{a: 16777217} == {a: 16777216.0}|
Log |1 == true|
Empty {}
|none| = Empty
|alsoNone| = Empty
Log |none == alsoNone|
Log |none != 0|

Try { Log |[1] < [2]| } Catch { Log |"ordering requires numbers"| }
Try { Log |[missing] == []| } Catch { Log |"operands must evaluate first"| }
