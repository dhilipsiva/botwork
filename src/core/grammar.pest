WHITESPACE = _{ (" " | "\t")+ }
line_end   = _{ "\r\n" | "\n" }
botwork    = _{ SOI ~ statements* ~ EOI }

// Suite declarations have their own entry point. These words remain available
// as ordinary custom-statement names in scripts and imported libraries.
test_suite = { SOI ~ line_end* ~ suite_definition ~ line_end* ~ EOI }
suite_definition = { ^"suite" ~ line_end* ~ suite_id ~ (line_end* ~ suite_name)? ~ (line_end* ~ suite_tags)? ~ line_end* ~ "{" ~ line_end* ~ (suite_dataset ~ line_end*)* ~ (suite_library ~ line_end*)? ~ (suite_case ~ line_end*)+ ~ "}" }
suite_id = { "|" ~ string ~ "|" }
suite_name = { ^"named" ~ line_end* ~ suite_id }
suite_tags = { ^"tags" ~ line_end* ~ "|" ~ "[" ~ line_end* ~ (string ~ (line_end* ~ "," ~ line_end* ~ string)* ~ line_end* ~ ","?)? ~ line_end* ~ "]" ~ "|" }
suite_library = { ^"library" ~ line_end* ~ stmt_block }
suite_case = { ^"case" ~ line_end* ~ suite_id ~ (line_end* ~ suite_name)? ~ (line_end* ~ suite_tags)? ~ (line_end* ~ suite_using)? ~ line_end* ~ stmt_block }
suite_using = { ^"using" ~ line_end* ~ suite_id ~ line_end* ~ AS ~ line_end* ~ "|" ~ ident ~ "|" }
suite_dataset = { dataset_external | dataset_inline }
dataset_external = { ^"dataset" ~ line_end* ~ suite_id ~ line_end* ~ ^"from" ~ line_end* ~ suite_id }
dataset_document = { SOI ~ line_end* ~ dataset_inline ~ line_end* ~ EOI }
dataset_inline = { ^"dataset" ~ line_end* ~ suite_id ~ (line_end* ~ suite_name)? ~ (line_end* ~ suite_tags)? ~ line_end* ~ "{" ~ line_end* ~ (dataset_row ~ line_end*)+ ~ "}" }
dataset_row = { ^"row" ~ line_end* ~ suite_id ~ (line_end* ~ suite_name)? ~ (line_end* ~ suite_tags)? ~ line_end* ~ ^"values" ~ line_end* ~ "|" ~ line_end* ~ dataset_value ~ line_end* ~ "|" }
dataset_value = _{ dataset_map | dataset_array | string | dataset_number | boolean | dataset_none }
dataset_number = { (minus ~ line_end*)? ~ (float | integer) }
dataset_none = { "none" ~ !ident_continue }
dataset_array = { "[" ~ line_end* ~ (dataset_value ~ (line_end* ~ "," ~ line_end* ~ dataset_value)* ~ line_end* ~ ","?)? ~ line_end* ~ "]" }
dataset_map = { "{" ~ line_end* ~ (dataset_entry ~ (line_end* ~ "," ~ line_end* ~ dataset_entry)* ~ line_end* ~ ","?)? ~ line_end* ~ "}" }
dataset_entry = { (keyword | string) ~ line_end* ~ ":" ~ line_end* ~ dataset_value }

ident_start    = _{ XID_START | "_" }
ident_continue = _{ XID_CONTINUE }
reserved       = @{ ("true" | "false" | "and" | "or") ~ !ident_continue }

// Special statements. Can cause changes to program behaviour.
// Atomic lookahead checks the adjacent delimiter without emitting keyword pairs.
// The literal prechecks below retain contextual diagnostics for absent keywords.
control_keyword = @{
    (^"if" | ^"in" | ^"else" | ^"for" | ^"break" | ^"return"
        | ^"continue" | ^"while" | ^"try" | ^"catch" | ^"finally" | ^"rethrow" | ^"import" | ^"as")
    ~ &(" " | "\t" | "\r" | "\n" | "|" | "{" | "}" | "#" | "\\" | EOI)
}
IF       = _{ &^"if" ~ &control_keyword ~ ^"if" }
IN       = _{ &^"in" ~ &control_keyword ~ ^"in" }
ELSE     = _{ &^"else" ~ &control_keyword ~ ^"else" }
FOR      = _{ &^"for" ~ &control_keyword ~ ^"for" }
BREAK    = _{ &^"break" ~ &control_keyword ~ ^"break" }
RETURN   = _{ &^"return" ~ &control_keyword ~ ^"return" }
CONTINUE = _{ &^"continue" ~ &control_keyword ~ ^"continue" }
WHILE    = _{ &^"while" ~ &control_keyword ~ ^"while" }
TRY      = _{ &^"try" ~ &control_keyword ~ ^"try" }
CATCH    = _{ &^"catch" ~ &control_keyword ~ ^"catch" }
FINALLY  = _{ &^"finally" ~ &control_keyword ~ ^"finally" }
RETHROW  = _{ &^"rethrow" ~ &control_keyword ~ ^"rethrow" }
IMPORT   = _{ &^"import" ~ &control_keyword ~ ^"import" }
AS       = _{ &^"as" ~ &control_keyword ~ ^"as" }

reserved_parts = _{ IF | ELSE | FOR | BREAK | RETURN | CONTINUE | WHILE | TRY | CATCH | FINALLY | RETHROW | IMPORT }

COMMENT       = _{ comment_block | comment_line }
comment_block = @{ "###" ~ (!"###" ~ ANY)* ~ "###" }
comment_line  = @{ !"###" ~ "#" ~ (!("\r" | "\n") ~ ANY)* }

continuation  = @{ "\\" ~ (" " | "\t")* ~ line_end }
part          = @{ (!("|" | "{" | "}" | "\r" | "\n" | "#" | "\\") ~ ANY)+ }
statements    = _{ stmt_break | stmt_continue | stmt_return | stmt_rethrow | stmt_import | stmt_if | stmt_for | stmt_while | stmt_try | stmt_define | stmt_assign | stmt_invoke | line_end }
stmt_import   =  { IMPORT ~ line_end* ~ "|" ~ string ~ "|" ~ line_end* ~ AS ~ line_end* ~ param_define }
stmt_assign   =  { param_define ~ line_end* ~ "=" ~ line_end* ~ (stmt_invoke | param_invoke) }
stmt_if       =  { IF ~ line_end* ~ param_invoke ~ line_end* ~ stmt_block ~ (line_end* ~ stmt_else)? }
stmt_else     =  { ELSE ~ line_end* ~ (stmt_block | stmt_if) }
stmt_for      =  { FOR ~ line_end* ~ param_define ~ line_end* ~ IN ~ line_end* ~ param_invoke ~ line_end* ~ stmt_block }
stmt_while    =  { WHILE ~ line_end* ~ param_invoke ~ line_end* ~ stmt_block }
stmt_try      =  { TRY ~ line_end* ~ stmt_block ~ line_end* ~ (stmt_catch ~ (line_end* ~ stmt_finally)? | stmt_finally) }
stmt_catch    =  { CATCH ~ line_end* ~ (param_define ~ line_end*)? ~ stmt_block }
stmt_finally  =  { FINALLY ~ line_end* ~ stmt_block }
stmt_define   =  { stmt_header ~ line_end* ~ stmt_block }
stmt_header   =  { !reserved_parts ~ part ~ (continuation? ~ (param_define | part))* }
native_signature = _{ SOI ~ stmt_header ~ EOI }
stmt_invoke   =  { !reserved_parts ~ part ~ (continuation? ~ (param_invoke | part))* }
stmt_block    =  { "{" ~ statements* ~ "}" }
stmt_break    =  { BREAK }
stmt_continue =  { CONTINUE }
stmt_return   =  { RETURN ~ (continuation? ~ param_invoke)? }
stmt_rethrow  =  { RETHROW }
param_invoke  =  { "|" ~ expression ~ "|" }
param_define  = _{ "|" ~ ident ~ "|" }

expression        =  { line_end* ~ expression_inner ~ (line_end* ~ binary_operator ~ line_end* ~ expression_inner)* ~ line_end* }
expression_inner  = _{ unary | power }
braced_expression =  { "(" ~ expression ~ ")" }
unary             =  { unary_operator ~ line_end* ~ expression_inner }
power             =  { primary ~ (line_end* ~ exponent ~ line_end* ~ expression_inner)? }
primary           =  { (call_expression | literal | ident | braced_expression) ~ (line_end* ~ (named_access | computed_access))* }
call_expression   =  { "@{" ~ line_end* ~ stmt_invoke ~ line_end* ~ "}" }
named_access      =  { "." ~ line_end* ~ (ident | path_index) }
path_index        = @{ NUMBER+ }
computed_access   =  { "[" ~ expression ~ "]" }
literal           = _{ map | array | string | float | integer | boolean }
array             =  { "[" ~ line_end* ~ (expression ~ ("," ~ expression)* ~ ","?)? ~ line_end* ~ "]" }
ident             = @{ !reserved ~ ident_start ~ ident_continue* }

map       =  { "{" ~ line_end* ~ (map_pair ~ ("," ~ line_end* ~ map_pair)* ~ ","?)? ~ line_end* ~ "}" }
map_pair  =  { (keyword | string) ~ line_end* ~ seperator ~ expression }
keyword   = @{ ident }
seperator = _{ ":" }

integer = @{ ASCII_DIGIT+ }
float   = @{ ASCII_DIGIT+ ~ "." ~ ASCII_DIGIT+ }

string           = ${ string_delimiter ~ string_content ~ string_delimiter }
string_content   = ${ (string_escape | !(string_delimiter | "\\") ~ ANY)* }
string_delimiter = _{ "\"" }
string_escape    = _{ "\\" ~ ("\"" | "\\" | "n") }

exponent              = { "^" }
multiply              = { "*" }
divide                = { "/" }
modulus               = { "%" }
plus                  = { "+" }
minus                 = { "-" }
less_than             = { "<" }
less_than_or_equal    = { "<=" }
greater_than          = { ">" }
greater_than_or_equal = { ">=" }
not_equal             = { "!=" }
equal                 = { "==" }
logical_and           = @{ "and" ~ !ident_continue }
logical_or            = @{ "or" ~ !ident_continue }
logical_not           = { "!" }

binary_operator = _{
    multiply
  | divide
  | modulus
  | plus
  | minus
  | less_than_or_equal
  | less_than
  | greater_than_or_equal
  | greater_than
  | not_equal
  | equal
  | logical_and
  | logical_or
}
unary_operator  = _{ minus | logical_not }

boolean       = _{ boolean_true | boolean_false }
boolean_true  = @{ "true" ~ !ident_continue }
boolean_false = @{ "false" ~ !ident_continue }
