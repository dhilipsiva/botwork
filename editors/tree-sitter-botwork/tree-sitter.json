{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "botwork",
      "camelcase": "Botwork",
      "scope": "source.botwork",
      "path": "botwork",
      "file-types": [
        "botwork"
      ],
      "highlights": "queries/highlights.scm",
      "injection-regex": "^botwork$"
    },
    {
      "name": "botwork_suite",
      "camelcase": "BotworkSuite",
      "scope": "source.botwork.suite",
      "path": "suite",
      "file-types": [
        "suite.botwork",
        "dataset.botwork"
      ],
      "highlights": [
        "queries/highlights.scm",
        "queries/suite-highlights.scm"
      ]
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Botwork scripts, suites, and datasets",
    "authors": [
      {
        "name": "dhilipsiva"
      }
    ],
    "links": {
      "repository": "https://github.com/dhilipsiva/botwork"
    }
  },
  "bindings": {
    "c": true,
    "go": false,
    "node": false,
    "python": false,
    "rust": false,
    "swift": false,
    "zig": false
  }
}
